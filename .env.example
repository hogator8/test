# Supabase project settings (server-side only; never exposed to the browser)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# Supabase project settings exposed to the browser, used only for teacher
# authentication (Supabase Auth sign-in/sign-up/password-reset calls made
# directly from the client). Every other read/write still goes through the
# server-side API Routes with the service role key above.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here

# Shared passphrase required to self-register a new teacher account
# (see /teacher/register). Not used for day-to-day login anymore - each
# teacher has their own Supabase Auth email/password.
TEACHER_PASSWORD=change-me

# Secret used to sign student/teacher session cookies (JWT). Use a long random string.
AUTH_SECRET=replace-with-a-long-random-string
